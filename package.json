{
  "name": "superblocks-azure-token-exchange",
  "version": "1.0.0",
  "description": "Token exchange handler for Superblocks (AWS Lambda or Azure Functions): validate Entra access token, return original token",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "sam:build": "sam build",
    "sam:local": "sam local start-api --env-vars env.local.json",
    "sam:invoke": "sam local invoke TokenExchangeFunction --env-vars env.local.json -e events/token-exchange.json",
    "local:sync-env": "node scripts/sync-local-env.mjs",
    "func:start": "node scripts/func-start.mjs",
    "func:publish": "func azure functionapp publish",
    "func:publish:azure": "node scripts/azure-publish.mjs",
    "test:snowflake": "node test/snowflake.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@azure/functions": "^4.7.2",
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "esbuild": "^0.27.3",
    "snowflake-sdk": "^2.1.0"
  }
}
